{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=cloudgames.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/log-.json",
                "rollingInterval": "Day",
                "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                "fileSizeLimitBytes": 5242880,
                "rollOnFileSizeLimit": true
              }
            }
          ]
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "cloudgames",
    "Audience": "cloudgames_clients",
    "Secret": "__SET_WITH_USER_SECRETS__",
    "ExpiryMinutes": 60
  },
  "AdminUser": {
    "Name": "Super",
    "Email": "super@cloudgames.com",
    "Password": "__SET_WITH_USER_SECRETS__",
    "Role": "Administrator",
    "Status": "Active",
    "EmailConfirmed": true
  },
  "AllowedHosts": "*"
}
